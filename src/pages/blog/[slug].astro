---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Section from '../../components/Section.astro';
import { getPostBySlug } from '../../utils/blog';

const { slug } = Astro.params;
const apiKey = Astro.locals.runtime?.env?.KIT_API_KEY;
const post = apiKey && slug ? await getPostBySlug(apiKey, slug) : null;

// Miss → 404 status; Astro renders src/pages/404.astro for the body.
if (!post) {
  Astro.response.status = 404;
}
---

{post && (
  <BaseLayout
    title={`${post.subject} — TomProtects`}
    description={post.excerpt}
    ogType="article"
    publishedTime={post.date}
    footerNewsletter={false}
  >
    <Section width="text">
      <article>
        <header>
          {post.dateLabel && (
            <p class="text-sm text-ink/60">
              <time datetime={post.date}>{post.dateLabel}</time>
            </p>
          )}

          <h1 class="mt-2 text-4xl font-semibold leading-tight tracking-tight">{post.subject}</h1>
        </header>

        {/* Sanitized in src/utils/sanitize.ts before it ever reaches this page. */}
        <div class="post-content mt-10 max-w-2xl" set:html={post.content} />
      </article>

      <p class="mt-12">
        <a href="/blog" class="font-medium text-accent underline-offset-4 hover:underline">
          Back to all posts
        </a>
      </p>
    </Section>

    <Section background="cream" width="text">
      <NewsletterSignup
        id="post"
        source="source-blog"
        variant="panel"
        heading="Get these by email"
        buttonLabel="Send me the checklist"
      />
    </Section>
  </BaseLayout>
)}

<style is:global>
  .post-content {
    color: #1a1a1a;
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .post-content p {
    margin: 0 0 1.1em;
  }
  .post-content a {
    color: #0f5c4c;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-content h2 {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 1.6em 0 0.5em;
    line-height: 1.2;
  }
  .post-content h3 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 1.4em 0 0.5em;
  }
  .post-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.2em 0;
  }
  .post-content ul,
  .post-content ol {
    margin: 0 0 1.1em 1.25em;
  }
  .post-content li {
    margin: 0.3em 0;
  }
  .post-content blockquote {
    border-left: 3px solid #0f5c4c;
    padding-left: 1em;
    color: #5c5750;
    margin: 1.2em 0;
  }
</style>
