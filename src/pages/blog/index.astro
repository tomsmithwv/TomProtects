---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import Callout from '../../components/Callout.astro';
import { getPublicBroadcasts } from '../../utils/blog';

// Server-rendered at request time; Kit responses are edge-cached ~1h, so new
// public broadcasts appear within the cache window without a redeploy.
const apiKey = Astro.locals.runtime?.env?.KIT_API_KEY;
const posts = apiKey ? await getPublicBroadcasts(apiKey) : [];
---

<BaseLayout
  title="Blog — TomProtects"
  description="Notes on building a security program in a growing business, written in plain language."
  footerNewsletter={false}
>
  <Section width="text">
    <h1 class="text-4xl font-semibold tracking-tight">Blog</h1>

    <p class="mt-6 max-w-2xl text-lg text-ink/70">
      Notes on building a security program in a growing business. Every post is sent to the
      newsletter first.
    </p>

    {posts.length === 0 ? (
      <Callout class="mt-10 max-w-2xl">
        <p class="text-ink/80">
          Nothing has been published here yet. Subscribe below and each new piece will reach you as
          soon as it goes out.
        </p>
      </Callout>
    ) : (
      <ul class="mt-12 grid list-none gap-4 p-0">
        {posts.map((p) => (
          <li>
            <Card>
              <h2 class="text-xl font-semibold">
                <a href={`/blog/${p.slug}`} class="text-ink no-underline transition hover:text-accent">
                  {p.subject}
                </a>
              </h2>

              {p.dateLabel && (
                <p class="mt-2 text-sm text-ink/60">
                  <time datetime={p.date}>{p.dateLabel}</time>
                </p>
              )}

              {p.excerpt && <p class="mt-3 max-w-2xl text-ink/70">{p.excerpt}</p>}
            </Card>
          </li>
        ))}
      </ul>
    )}
  </Section>

  <Section background="cream" width="text">
    <NewsletterSignup
      id="blog-index"
      source="source-blog"
      variant="panel"
      heading="Get these by email"
      buttonLabel="Send me the checklist"
    />
  </Section>
</BaseLayout>
