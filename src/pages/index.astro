---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import FounderPhoto from '../components/FounderPhoto.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import RuleList from '../components/RuleList.astro';
import Callout from '../components/Callout.astro';
import PullQuote from '../components/PullQuote.astro';

// The questions a reader in this situation is already carrying. Ordered roughly
// as they surface: broad worry first, then spending, then the people question.
const questions = [
  'Are we secure enough?',
  'What should we fix first?',
  'Are we spending money on the right things?',
  'Do we really need this security product?',
  'Is our IT provider doing enough?',
  'How do we reduce business risk?',
  'How do we build a security program without hiring a full-time CISO?',
];

// Services folded into the outcome rather than listed, so the reader sees what
// they get before they see what it is called. The icon on each card is
// decorative: the heading beside it already says the same thing.
const help = [
  {
    icon: 'shield',
    heading: 'Understand where you stand',
    body: `Before anything else, you need an accurate picture. A security foundation assessment
      looks at how your business actually operates and where the real exposure sits. Most often
      that is identity and access, and the email and productivity platform your team lives in all
      day. A maturity assessment puts that in context, so you can see how far along you are rather
      than only what is broken.`,
  },
  {
    icon: 'route',
    heading: 'Know what to do next',
    body: `A list of findings is not a plan. I turn what we learn into a prioritized roadmap: what
      to do now, what can wait, and what you can reasonably set aside. That includes the practical
      pieces: security policies people will actually follow, and having your answers in order
      before a cyber insurance renewal or a customer security review.`,
  },
  {
    icon: 'clock',
    heading: 'Keep it moving',
    body: `Most security work stalls at the follow-through. As a fractional CISO I stay involved
      month to month: keeping the roadmap current, reviewing new vendors and SaaS tools before they
      are woven into your business, confirming your backups would genuinely get you running again,
      and shaping security awareness that feels useful rather than like a compliance exercise.`,
  },
  {
    icon: 'compass',
    heading: 'Newer risks, handled calmly',
    body: `AI is arriving in businesses faster than the guidance around it. The useful questions are
      plain ones: which tools are people already using, what business data goes into them, and what
      needs to be written down. This is more a governance question than a technical one, and it is
      manageable with clear expectations.`,
  },
] as const;
---

<BaseLayout
  title="TomProtects — Fractional CISO &amp; Security Advisor"
  description="Fractional CISO and security advisory for growing businesses. Understand where you stand, what matters most, and what to do next."
  footerNewsletter={false}
>
  <!-- 1. Hero: positioning, the checklist offer, and the signup -->
  <Section
    background="gradient"
    width="text"
    py="none"
    innerClass="py-14 sm:py-20 lg:grid lg:max-w-6xl lg:grid-cols-[1fr_300px] lg:items-center lg:gap-12"
  >
      <!-- Photo cluster: above headline on mobile, right column on desktop -->
      <div class="mb-8 flex items-center justify-center gap-1 lg:order-2 lg:mb-0 lg:block">
        <p class="-rotate-6 font-handwritten text-3xl text-accent lg:mb-1 lg:ml-6 lg:text-4xl">
          Hi, I'm Tom!
        </p>
        <!-- Hand-drawn arrow from caption to photo -->
        <svg
          viewBox="0 0 60 60"
          class="h-9 w-9 shrink-0 text-accent lg:ml-24 lg:h-12 lg:w-12 lg:rotate-[65deg]"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 14 C 22 10, 40 20, 47 42"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <path
            d="M38 38 L47 42 L49 32"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <picture>
          <source srcset="/images/tom-hero-560.webp" type="image/webp" />
          <img
            src="/images/tom-hero-560.jpg"
            alt="Tom Smith, founder of TomProtects, smiling in a navy blazer"
            width="560"
            height="560"
            loading="eager"
            decoding="async"
            class="h-28 w-28 rounded-full object-cover ring-2 ring-accent/30 lg:h-72 lg:w-72"
          />
        </picture>
      </div>

      <div class="text-center lg:order-1">
        <Eyebrow class="mb-4">Fractional CISO &amp; Security Advisor</Eyebrow>
        <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          Helping growing businesses build their first real security program.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-ink/70 sm:text-xl">
          You know security matters. What's less clear is where to start, what to fix first, and who
          makes those calls when no one on staff owns security. I help you understand where you
          stand, what matters most, and what to do next.
        </p>

        {/*
          The offer is stated here rather than by the form, so the hero keeps one
          voice and the field can follow immediately. The full version of this
          component, with its own heading, sits at the foot of the page.
        */}
        <p class="mx-auto mt-6 max-w-2xl text-ink/70">
          Start with the free checklist:{' '}
          <em>The Security Questions Every Growing Business Should Be Able to Answer</em>. A
          self-scoring readiness check you can work through on your own.
        </p>

        <NewsletterSignup
          id="hero"
          variant="compact"
          buttonLabel="Send me the checklist"
          class="mx-auto mt-8 max-w-xl text-left"
        />

        <p class="mt-4 text-sm">
          <a href="/#about" class="text-accent underline-offset-4 hover:underline">
            More about how I work →
          </a>
        </p>
      </div>
  </Section>

  <!-- 2. The questions you're already asking -->
  <Section background="white" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      The questions you're already asking
    </h2>

    <RuleList items={questions} class="mt-8" />

    <p class="mt-8 max-w-2xl text-ink/70">
      These are reasonable questions, and they usually come up long before anyone in the business
      has the time or background to answer them properly. Working through them in order is most of
      what a security program is.
    </p>
  </Section>

  <!-- 3. How I help -->
  <Section background="cream" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">How I help</h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {help.map((h) => (
        <Card>
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-accent/10 text-accent">
            <Icon name={h.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-4 text-xl font-semibold">{h.heading}</h3>
          <p class="mt-2 text-sm text-ink/70">{h.body}</p>
        </Card>
      ))}
    </div>

    <Callout on="cream" class="mt-8 max-w-2xl">
      <p class="text-ink/80">
        Worth being clear about: this is advisory work. I do not sell products or take over your
        systems. Implementation happens through your existing IT staff or MSP, who know your
        environment. My part is making sure the right work is happening in the right order.
      </p>
    </Callout>
  </Section>

  <!-- 4. How I think about security -->
  <Section background="white" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      How I think about security
    </h2>

    <div class="mt-8 max-w-2xl space-y-6 text-ink/70">
      <p>
        Security should leave a business more confident, not more anxious. Fear is a poor basis for
        decisions. It tends to produce spending on whatever seems most urgent that week, rather than
        on what actually reduces risk.
      </p>

      <p>
        Good security is practical and sustainable. It fits the way your business already works, it
        can be maintained by the people you already have, and it is prioritized so the most
        important things happen first. A recommendation that cannot survive a busy quarter is not
        the right recommendation.
      </p>

      <p>
        It should also be understandable. You should be able to explain where your business stands
        to your leadership team, your insurer, or a customer without needing a translator. That
        means talking in terms of business outcomes rather than technical controls.
      </p>
    </div>

    <PullQuote class="mt-10 max-w-2xl">
      Most growing businesses do not need enterprise security. They need experienced guidance,
      applied to their actual situation.
    </PullQuote>
  </Section>

  <!-- 5. About -->
  <Section id="about" background="white" width="text" center class="scroll-mt-20">
      <FounderPhoto class="mx-auto h-32 w-32 sm:h-40 sm:w-40" />
      <Eyebrow class="mt-6">About</Eyebrow>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Hi, I'm Tom.</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink/70">
        I've spent 20+ years in IT and cybersecurity — protecting organizations from the same threats that now target
        online businesses. I help creators, consultants, and business owners lock down the domain, email, and platforms
        their livelihood runs on. No jargon, no fear-mongering — just clear, practical fixes.
      </p>
      <p class="mt-6 text-sm font-semibold text-accent">CISSP · CISM · CDPSE · 20+ years</p>
  </Section>

  <!-- 6. Latest from the newsletter (3 most recent, loaded client-side) -->
  <Section background="cream">
      <Eyebrow>From the newsletter</Eyebrow>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Latest writing</h2>

      <div id="latest-posts" class="mt-10 grid gap-6 md:grid-cols-3"></div>

      <p class="mt-8">
        <a href="/blog" class="font-medium text-accent underline-offset-4 hover:underline">Read the blog →</a>
      </p>
  </Section>

  <!-- 7. Newsletter: the page's closing action, and its primary conversion -->
  <Section background="ink" width="text">
    <NewsletterSignup
      id="newsletter"
      variant="panel"
      onDark
      buttonLabel="Send me the checklist"
    />
  </Section>

  <script>
    // Fill the "Latest from the newsletter" section from /api/posts. Home stays
    // prerendered; this enhances it. On empty/error, the "Read the blog" link remains.
    (async () => {
      const wrap = document.getElementById('latest-posts');
      if (!wrap) return;
      try {
        const res = await fetch('/api/posts');
        if (!res.ok) return;
        const { posts } = await res.json();
        if (!Array.isArray(posts) || posts.length === 0) {
          wrap.innerHTML = `<p style="color:#5c5750;">First issue coming soon. <a href="/blog" style="color:#0f5c4c;font-weight:500;text-decoration:underline;">Subscribe →</a></p>`;
          return;
        }
        const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
        wrap.innerHTML = posts
          .map((p: any) => `
            <a href="/blog/${esc(p.slug)}" style="display:block;background:#fff;border:1px solid rgba(0,0,0,0.1);border-radius:12px;padding:20px;text-decoration:none;color:inherit;">
              <h3 style="font-weight:600;font-size:1.05rem;margin:0;">${esc(p.subject)}</h3>
              ${p.dateLabel ? `<p style="font-size:0.8rem;color:#6b6b6b;margin:6px 0 0;">${esc(p.dateLabel)}</p>` : ''}
              ${p.excerpt ? `<p style="font-size:0.9rem;color:#5c5750;margin:8px 0 0;line-height:1.5;">${esc(p.excerpt)}</p>` : ''}
              <span style="display:inline-block;margin-top:10px;font-size:0.85rem;font-weight:500;color:#0f5c4c;">Read →</span>
            </a>`)
          .join('');
      } catch {
        /* leave the section empty; the Read the blog link still works */
      }
    })();
  </script>
</BaseLayout>
