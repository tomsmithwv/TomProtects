---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import RuleList from '../components/RuleList.astro';
import Callout from '../components/Callout.astro';
import PullQuote from '../components/PullQuote.astro';

// The questions a reader in this situation is already carrying, in the words
// they would actually use. Ordered roughly as they surface: the broad worry,
// then the one that prompts most first calls, then spending, then the people
// question. Phishing sits second because it is what people ask about first —
// it is the part of security they have already seen with their own eyes.
const questions = [
  'Am I secure enough?',
  'How do I stop someone falling for a phishing email?',
  'What should I fix first?',
  'Am I spending money on the right things?',
  'Do I really need this security product?',
  'Who still has access to my accounts?',
  'What happens if I get locked out of Stripe or YouTube for a week?',
  'Who is supposed to be handling all of this?',
];

// The reader should find themselves here before they read anything else. Four
// kinds of online business, each described by what it depends on rather than
// by a category label. The thing they have in common (no IT person, and no
// clear sense of what "secure enough" means) is the intro paragraph, not a
// fifth card: it is the thread through all four.
const audience = [
  {
    heading: 'Coaches and consultants',
    body: 'Your clients trust you with sensitive information.',
  },
  {
    heading: 'Creators and newsletter operators',
    body: 'Your audience lives in a few platforms.',
  },
  {
    heading: 'Course and membership sellers',
    body: 'Your revenue runs through Stripe and a course platform.',
  },
  {
    heading: 'Small online teams',
    body: 'You share access with VAs and contractors.',
  },
] as const;

// How a first engagement is shaped. This describes a process, not a history:
// every line is present or conditional tense, and none of it claims an
// engagement has already happened. No "most clients", no "we found", no
// outcomes and no numbers — a process can be described honestly before it has
// ever run, and a result cannot.
const steps = [
  {
    heading: 'A short intro call',
    body: `A short, no-pressure call about how your business runs online and what's on your mind.
      If it isn't the right fit, that's a useful thing to find out in the first ten minutes.`,
  },
  {
    heading: 'A review and a written plan',
    body: `We look at your accounts, email, domain, and backups together on a call, with you logged
      in. Then I write up a plan with your priorities in order: what to fix first, what can wait,
      and why.`,
  },
  {
    heading: 'Working sessions',
    body: `If you'd like help, we make the changes together on screen-share. You stay logged in, and
      you keep your logins. I work with you, not instead of you.`,
  },
  {
    heading: 'A follow-up check-in',
    body: `About three months later, we do a follow-up review to make sure everything's still in
      place.`,
  },
] as const;

// Services folded into the outcome rather than listed, so the reader sees what
// they get before they see what it is called. The icon on each card is
// decorative: the heading beside it already says the same thing.
const help = [
  {
    icon: 'shield',
    heading: 'Accounts and access',
    body: `Who has access to what, and how to clean it up. That means logins shared with VAs and
      contractors, MFA (a second check when you sign in) on the accounts that matter (Stripe,
      YouTube, your email, your domain registrar), and a plan for getting back in if you're ever
      locked out.`,
  },
  {
    icon: 'route',
    heading: 'Email and domain',
    body: `Make sure your emails land in inboxes and nobody can send as you. Your domain, DNS, and
      email authentication (SPF, DKIM, and DMARC), set up right and written down.`,
  },
  {
    icon: 'clock',
    heading: 'Backups and continuity',
    body: `What happens if a platform locks you out or a laptop dies. Backups for the things you
      can't recreate, and a simple plan so one bad day doesn't stop the business.`,
  },
  {
    icon: 'compass',
    heading: 'Ongoing security guidance',
    body: `A security advisor you can call on. You get a prioritized roadmap, help with vendor and
      AI tool decisions, and answers when a client asks about your security practices or a cyber
      insurance form shows up.`,
  },
] as const;
---

<BaseLayout
  title="TomProtects — Security for online businesses that run on trust"
  description="A security advisor for online businesses. I help you protect the accounts, email, and access that keep your business running."
  footerNewsletter={false}
>
  <!-- 1. Hero: positioning, the checklist offer, and the signup -->
  <Section
    background="gradient"
    width="text"
    py="none"
    innerClass="py-14 sm:py-20 lg:grid lg:max-w-6xl lg:grid-cols-[1fr_300px] lg:items-center lg:gap-12"
  >
      <!-- Photo cluster: above headline on mobile, right column on desktop -->
      <div class="mb-8 flex items-center justify-center gap-1 lg:order-2 lg:mb-0 lg:block">
        <p class="-rotate-6 font-handwritten text-3xl text-accent lg:mb-1 lg:ml-6 lg:text-4xl">
          Hi, I'm Tom!
        </p>
        <!-- Hand-drawn arrow from caption to photo -->
        <svg
          viewBox="0 0 60 60"
          class="h-9 w-9 shrink-0 text-accent lg:ml-24 lg:h-12 lg:w-12 lg:rotate-[65deg]"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 14 C 22 10, 40 20, 47 42"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <path
            d="M38 38 L47 42 L49 32"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <picture>
          <source srcset="/images/tom-hero-560.webp" type="image/webp" />
          <img
            src="/images/tom-hero-560.jpg"
            alt="Tom Smith, founder of TomProtects, smiling in a navy blazer"
            width="560"
            height="560"
            loading="eager"
            decoding="async"
            class="h-28 w-28 rounded-full object-cover ring-2 ring-accent/30 lg:h-72 lg:w-72"
          />
        </picture>
      </div>

      <div class="text-center lg:order-1">
        <Eyebrow class="mb-4">Security advisor</Eyebrow>
        <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          Security for online businesses that run on trust.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-ink/70 sm:text-xl">
          You built a business on your expertise, your audience, and your client relationships. I
          help you protect the accounts, email, and access that keep it running.
        </p>

        {/*
          The offer is stated here rather than by the form, so the hero keeps one
          voice and the field can follow immediately. The full version of this
          component, with its own heading, sits at the foot of the page.
        */}
        <p class="mx-auto mt-6 max-w-2xl text-ink/70">
          Start with the free checklist:{' '}
          <em>The Security Questions Every Growing Business Should Be Able to Answer</em>. 26
          questions to find the gaps in your accounts, email, backups, and access. Takes about 15
          minutes. No security background needed.
        </p>

        <NewsletterSignup
          id="hero"
          variant="compact"
          buttonLabel="Send me the checklist"
          class="mx-auto mt-8 max-w-xl text-left"
        />

        <p class="mt-4 text-sm">
          <a href="/about" class="text-accent underline-offset-4 hover:underline">
            More about how I work →
          </a>
        </p>
      </div>
  </Section>

  <!--
    2. Who this is for. Placed before the questions so a reader confirms the page
    is about them before being asked to recognise themselves in a list. Cream
    keeps the alternation intact: the hero gradient closes on a hairline, and
    every band after this one keeps the ground it already had.
  -->
  <Section background="cream" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">Who this is for</h2>

    <p class="mt-6 max-w-2xl text-ink/70">
      Coaches, consultants, creators, and course sellers running a real business online. You might
      work solo or with a VA, editor, or a few contractors. You don't have an IT person, and
      you're not sure what "secure enough" looks like for a business your size.
    </p>

    {/*
      Two across from md, not three: four cards in a three-column grid leave one
      orphaned on its own row, the same sparse shape the post grid was fixed for.
      md rather than sm because two-up cards get cramped at 640px.
    */}
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {audience.map((a) => (
        <Card>
          <h3 class="text-xl font-semibold">{a.heading}</h3>
          <p class="mt-2 text-sm text-ink/70">{a.body}</p>
        </Card>
      ))}
    </div>

    <h3 class="mt-12 text-xl font-semibold">Who this isn't for</h3>
    <p class="mt-3 max-w-2xl text-ink/70">
      Businesses with an in-house IT or security team, or anyone looking for a quick tool
      recommendation instead of a plan.
    </p>
  </Section>

  <!-- 3. The questions you're already asking -->
  <Section background="white" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      The questions you're already asking
    </h2>

    <RuleList items={questions} class="mt-8" />

    <p class="mt-8 max-w-2xl text-ink/70">
      These are reasonable questions. They tend to come up before you have the time or background
      to answer them properly. Working through them in order is most of what a security program
      is.
    </p>
  </Section>

  <!-- 4. How I help -->
  <Section id="how-i-help" background="cream" width="text" class="scroll-mt-20">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">How I help</h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {help.map((h) => (
        <Card>
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-accent/10 text-accent">
            <Icon name={h.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-4 text-xl font-semibold">{h.heading}</h3>
          <p class="mt-2 text-sm text-ink/70">{h.body}</p>
        </Card>
      ))}
    </div>

    <Callout on="cream" class="mt-8 max-w-2xl">
      <p class="text-ink/80">
        Worth being clear about: I work with you, not instead of you. We go through the changes
        together, step by step, and you keep the logins. I don't sell products, and I don't take
        over your accounts.
      </p>
    </Callout>
  </Section>

  <!-- 5. How I think about security -->
  <Section background="white" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      How I think about security
    </h2>

    <div class="mt-8 max-w-2xl space-y-6 text-ink/70">
      <p>
        Security should leave you more confident, not more anxious. Fear is a poor basis for
        decisions. It tends to produce spending on whatever seems most urgent that week, rather
        than on what actually reduces risk.
      </p>

      <p>
        Good security is practical and sustainable. It fits the way you already work, you can keep
        it up yourself (with help from a VA or contractor if you have one), and it is prioritized
        so the most important things happen first. A recommendation that cannot survive a busy
        month is not the right recommendation.
      </p>

      <p>
        It should also be understandable. You should be able to explain where you stand to a
        client, your insurer, or a partner without needing a translator. That means talking in
        terms of real-world outcomes rather than technical controls.
      </p>
    </div>

    <PullQuote class="mt-10 max-w-2xl">
      A business your size doesn't need enterprise security. It needs experienced guidance,
      applied to your actual situation.
    </PullQuote>
  </Section>

  <!-- 6. Latest from the newsletter (3 most recent, loaded client-side) -->
  <Section background="cream">
      <Eyebrow>From the newsletter</Eyebrow>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Latest writing</h2>

      <div id="latest-posts" class="mt-10 grid gap-6 md:grid-cols-3"></div>

      <p class="mt-8">
        <a href="/blog" class="font-medium text-accent underline-offset-4 hover:underline">Read the blog →</a>
      </p>
  </Section>

  <!--
    7. What working together looks like. Sits here, after "Latest writing" and
    before the closing panel, because knowing how a thing starts is the last
    doubt to settle before the ask — and because white here leaves every band
    above it on the ground it already had. Moving it means re-checking the
    cream/white alternation from that point down.

    An <ol>, because these are ordered steps and the numbers carry meaning; the
    badge reuses the tile that holds an icon in "How I help", with a numeral in
    place of the glyph. h-full so cards in a row match height rather than each
    shrinking to its own copy.
  -->
  <Section background="white" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      What working together looks like
    </h2>

    <p class="mt-6 max-w-2xl text-ink/70">
      A first engagement follows four steps. Nothing in it is a surprise, and you can stop after
      any of them.
    </p>

    <ol class="mt-10 grid list-none gap-4 p-0 sm:grid-cols-2">
      {steps.map((step, i) => (
        <li>
          <Card surface="cream" class="h-full">
            <span
              class="grid h-11 w-11 place-items-center rounded-lg bg-accent/10 text-lg font-semibold text-accent"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-4 text-xl font-semibold">{step.heading}</h3>
            <p class="mt-2 text-sm text-ink/70">{step.body}</p>
          </Card>
        </li>
      ))}
    </ol>
  </Section>

  <!-- 8. Newsletter: the closing action. Concise, because the hero above has
       already made the offer in full and repeating it verbatim reads as filler. -->
  <Section background="ink" width="text">
    <NewsletterSignup
      id="newsletter"
      variant="panel"
      onDark
      concise
      buttonLabel="Send me the checklist"
    />
  </Section>

  <script>
    // Fill the "Latest from the newsletter" section from /api/posts. Home stays
    // prerendered; this enhances it. On empty/error, the "Read the blog" link remains.
    (async () => {
      const wrap = document.getElementById('latest-posts');
      if (!wrap) return;
      try {
        const res = await fetch('/api/posts');
        if (!res.ok) return;
        const { posts } = await res.json();
        if (!Array.isArray(posts) || posts.length === 0) {
          // The grid's gap would otherwise indent a single paragraph oddly.
          wrap.className = 'mt-10';
          wrap.innerHTML =
            '<p class="max-w-2xl text-ink/70">Nothing has been published yet. The first piece will appear here as soon as it goes out.</p>';
          return;
        }
        // Three columns is right for three cards and wrong for one: a lone
        // card in a three-track grid sits at a third width with two empty
        // tracks beside it, which reads as a page that failed to load rather
        // than as a blog with one post. Below three, one full-width column.
        // md:grid-cols-3 also appears in the markup above, which is what keeps
        // Tailwind's scanner generating it.
        wrap.className = posts.length >= 3 ? 'mt-10 grid gap-6 md:grid-cols-3' : 'mt-10 grid gap-6';

        const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

        // Built by hand rather than with <Card>, because this section is filled
        // client-side and Astro components no longer exist by then. The classes
        // are the ones <Card> emits, written out in full so Tailwind's scanner
        // still generates them, and the h3 picks up Fraunces from the base layer
        // like any other heading.
        wrap.innerHTML = posts
          .map((p: any) => `
            <a href="/blog/${esc(p.slug)}" class="block rounded-xl border border-black/10 bg-white p-6 no-underline transition hover:border-accent/40">
              <h3 class="text-lg font-semibold text-ink">${esc(p.subject)}</h3>
              ${p.dateLabel ? `<p class="mt-2 text-sm text-ink/60">${esc(p.dateLabel)}</p>` : ''}
              ${p.excerpt ? `<p class="mt-3 text-sm text-ink/70">${esc(p.excerpt)}</p>` : ''}
              <span class="mt-4 inline-block text-sm font-medium text-accent">Read →</span>
            </a>`)
          .join('');
      } catch {
        /* leave the section empty; the Read the blog link still works */
      }
    })();
  </script>
</BaseLayout>
