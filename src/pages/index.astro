---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import RuleList from '../components/RuleList.astro';
import Callout from '../components/Callout.astro';
import PullQuote from '../components/PullQuote.astro';

// The questions a reader in this situation is already carrying, in the words
// they would actually use. Ordered roughly as they surface: the broad worry,
// then the one that prompts most first calls, then spending, then the people
// question. Phishing sits second because it is what people ask about first —
// it is the part of security they have already seen with their own eyes.
const questions = [
  'Are we secure enough?',
  'How do we stop someone falling for a phishing email?',
  'What should we fix first?',
  'Are we spending money on the right things?',
  'Do we really need this security product?',
  'Is our IT provider doing enough?',
  'What happens if we lose access to our systems for a week?',
  'Who is supposed to be in charge of all this?',
];

// The reader should find themselves here before they read anything else. Four
// rows rather than three: the last one catches an organization that is none of
// the first three and is in exactly the same position anyway.
const audience = [
  {
    heading: 'Small professional practices',
    body: 'Dental, medical, legal and accounting offices, holding records that patients and clients trusted you with.',
  },
  {
    heading: 'Small nonprofits',
    body: 'Donor details and program data, and a board that has started asking how all of it is protected.',
  },
  {
    heading: 'Local government agencies',
    body: 'Resident information and public accountability, usually on a budget that was set a year in advance.',
  },
  {
    heading: 'Anyone with no security owner',
    body: 'Capable IT, in-house or a provider, but nobody whose job is deciding what should happen next.',
  },
] as const;

// PLACEHOLDER — scaffolding for one anonymized engagement example, and nothing
// more. There is no client, no outcome, no quote and no number here, because
// none of them exist yet and inventing them would be inventing a reference.
// Each line below is an instruction to whoever fills this in, written to be
// impossible to mistake for copy.
const engagementExample = [
  {
    label: 'The situation',
    todo: 'TODO — the organization in one or two sentences: rough size, sector, and what prompted the call. No name, and no detail specific enough to identify it.',
  },
  {
    label: 'What was found',
    todo: 'TODO — what the assessment actually turned up, in plain language. Two or three things at most, described as a reader would recognise them rather than as findings with severities.',
  },
  {
    label: 'What changed',
    todo: 'TODO — what was different afterwards, and over roughly what period. Only what can be said plainly and truthfully; no figure that was never actually measured.',
  },
] as const;

// Services folded into the outcome rather than listed, so the reader sees what
// they get before they see what it is called. The icon on each card is
// decorative: the heading beside it already says the same thing.
const help = [
  {
    icon: 'shield',
    heading: 'Understand where you stand',
    body: `Before anything else, you need an accurate picture. A security foundation assessment
      looks at how your organization actually operates and where the real exposure sits. Most often
      that is identity and access, and the email and productivity platform your team lives in all
      day. A maturity assessment puts that in context, so you can see how far along you are rather
      than only what is broken.`,
  },
  {
    icon: 'route',
    heading: 'Know what to do next',
    body: `A list of findings is not a plan. I turn what we learn into a prioritized roadmap: what
      to do now, what can wait, and what you can reasonably set aside. That includes the practical
      pieces: security policies people will actually follow, and having your answers in order
      before a cyber insurance renewal or a customer security review. If part of your funding is
      grant-based, that can carry security expectations of its own, and the same preparation
      covers them.`,
  },
  {
    icon: 'clock',
    heading: 'Keep it moving',
    body: `Most security work stalls at the follow-through. So I stay involved month to month:
      keeping the roadmap current, reviewing new vendors and software before they are woven into how
      you work, confirming your backups would genuinely get you running again, and shaping security
      awareness that feels useful rather than like a compliance exercise. This is the part some
      people call a fractional CISO — a part-time security leader, shared across a few
      organizations rather than hired full time.`,
  },
  {
    icon: 'compass',
    heading: 'Newer risks, handled calmly',
    body: `AI is arriving in workplaces faster than the guidance around it. The useful questions are
      plain ones: which tools are people already using, what information goes into them, and what
      needs to be written down. This is more a governance question than a technical one, and it is
      manageable with clear expectations.`,
  },
] as const;
---

<BaseLayout
  title="TomProtects — Security advice for small organizations"
  description="Security advice for small practices, nonprofits and local government agencies with nobody whose job is security. Based in Morgantown, West Virginia, working across the region and remotely."
  footerNewsletter={false}
>
  <!-- 1. Hero: positioning, the checklist offer, and the signup -->
  <Section
    background="gradient"
    width="text"
    py="none"
    innerClass="py-14 sm:py-20 lg:grid lg:max-w-6xl lg:grid-cols-[1fr_300px] lg:items-center lg:gap-12"
  >
      <!-- Photo cluster: above headline on mobile, right column on desktop -->
      <div class="mb-8 flex items-center justify-center gap-1 lg:order-2 lg:mb-0 lg:block">
        <p class="-rotate-6 font-handwritten text-3xl text-accent lg:mb-1 lg:ml-6 lg:text-4xl">
          Hi, I'm Tom!
        </p>
        <!-- Hand-drawn arrow from caption to photo -->
        <svg
          viewBox="0 0 60 60"
          class="h-9 w-9 shrink-0 text-accent lg:ml-24 lg:h-12 lg:w-12 lg:rotate-[65deg]"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 14 C 22 10, 40 20, 47 42"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <path
            d="M38 38 L47 42 L49 32"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <picture>
          <source srcset="/images/tom-hero-560.webp" type="image/webp" />
          <img
            src="/images/tom-hero-560.jpg"
            alt="Tom Smith, founder of TomProtects, smiling in a navy blazer"
            width="560"
            height="560"
            loading="eager"
            decoding="async"
            class="h-28 w-28 rounded-full object-cover ring-2 ring-accent/30 lg:h-72 lg:w-72"
          />
        </picture>
      </div>

      <div class="text-center lg:order-1">
        <Eyebrow class="mb-4">Fractional CISO &amp; Security Advisor</Eyebrow>
        <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          Straightforward security for small practices, nonprofits, and local agencies.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-ink/70 sm:text-xl">
          You depend on technology for nearly everything, you hold information people trusted you
          with, and nobody on staff owns security. I help you build your first real security
          program: work out where you stand, what to fix first, and what can safely wait.
        </p>

        {/*
          Geography, stated flat and once. It qualifies a reader in rather than
          out, so both halves belong in the same sentence: nearby means I can be
          in the room, further away means we work remotely.
        */}
        <p class="mx-auto mt-4 max-w-2xl text-ink/70">
          I'm based in Morgantown, West Virginia, and work with organizations across the region —
          and remotely with those further afield.
        </p>

        {/*
          The offer is stated here rather than by the form, so the hero keeps one
          voice and the field can follow immediately. The full version of this
          component, with its own heading, sits at the foot of the page.
        */}
        <p class="mx-auto mt-6 max-w-2xl text-ink/70">
          Start with the free checklist:{' '}
          <em>The Security Questions Every Small Organization Should Be Able to Answer</em>. A
          self-scoring readiness check you can work through on your own.
        </p>

        <NewsletterSignup
          id="hero"
          variant="compact"
          buttonLabel="Send me the checklist"
          class="mx-auto mt-8 max-w-xl text-left"
        />

        <p class="mt-4 text-sm">
          <a href="/about" class="text-accent underline-offset-4 hover:underline">
            More about how I work →
          </a>
        </p>
      </div>
  </Section>

  <!--
    2. Who this is for. Placed before the questions so a reader confirms the page
    is about them before being asked to recognise themselves in a list. Cream
    keeps the alternation intact: the hero gradient closes on a hairline, and
    every band after this one keeps the ground it already had.
  -->
  <Section background="cream" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">Who this is for</h2>

    <p class="mt-6 max-w-2xl text-ink/70">
      Mostly organizations of five to twenty-five people, where technology runs almost everything
      and security belongs to nobody in particular.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {audience.map((a) => (
        <Card>
          <h3 class="text-xl font-semibold">{a.heading}</h3>
          <p class="mt-2 text-sm text-ink/70">{a.body}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- 3. The questions you're already asking -->
  <Section background="white" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      The questions you're already asking
    </h2>

    <RuleList items={questions} class="mt-8" />

    <p class="mt-8 max-w-2xl text-ink/70">
      These are reasonable questions, and they usually come up long before anyone on staff has the
      time or background to answer them properly. Working through them in order is most of what a
      security program is.
    </p>
  </Section>

  <!-- 4. How I help -->
  <Section id="how-i-help" background="cream" width="text" class="scroll-mt-20">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">How I help</h2>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {help.map((h) => (
        <Card>
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-accent/10 text-accent">
            <Icon name={h.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-4 text-xl font-semibold">{h.heading}</h3>
          <p class="mt-2 text-sm text-ink/70">{h.body}</p>
        </Card>
      ))}
    </div>

    <Callout on="cream" class="mt-8 max-w-2xl">
      <p class="text-ink/80">
        Worth being clear about: this is advisory work. I do not sell products or take over your
        systems. Implementation happens through the IT staff or provider you already have, who know
        your environment. My part is making sure the right work is happening in the right order.
      </p>
    </Callout>
  </Section>

  <!-- 5. How I think about security -->
  <Section background="white" width="text">
    <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      How I think about security
    </h2>

    <div class="mt-8 max-w-2xl space-y-6 text-ink/70">
      <p>
        Security should leave an organization more confident, not more anxious. Fear is a poor
        basis for decisions. It tends to produce spending on whatever seems most urgent that week,
        rather than on what actually reduces risk.
      </p>

      <p>
        Good security is practical and sustainable. It fits the way you already work, it can be
        maintained by the people you already have, and it is prioritized so the most important
        things happen first. A recommendation that cannot survive a busy month is not the right
        recommendation.
      </p>

      <p>
        It should also be understandable. You should be able to explain where you stand to your
        board, your insurer, or a client without needing a translator. That means talking in terms
        of real-world outcomes rather than technical controls.
      </p>
    </div>

    <PullQuote class="mt-10 max-w-2xl">
      A small organization does not need enterprise security. It needs experienced guidance,
      applied to its actual situation.
    </PullQuote>
  </Section>

  <!-- 6. Latest from the newsletter (3 most recent, loaded client-side) -->
  <Section background="cream">
      <Eyebrow>From the newsletter</Eyebrow>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Latest writing</h2>

      <div id="latest-posts" class="mt-10 grid gap-6 md:grid-cols-3"></div>

      <p class="mt-8">
        <a href="/blog" class="font-medium text-accent underline-offset-4 hover:underline">Read the blog →</a>
      </p>
  </Section>

  <!--
    7. Engagement example — PLACEHOLDER. This band ships empty on purpose and is
    not finished content. It sits here, after "Latest writing" and before the
    closing panel, for two reasons: proof reads best immediately before the ask,
    and white here is the one insertion point that leaves every band above it on
    the ground it already had. Moving it means re-checking the cream/white
    alternation from that point down.
  -->
  <Section background="white" width="text">
    <Eyebrow>Engagement example</Eyebrow>
    <h2 class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
      What this looks like in practice
    </h2>

    <Callout on="white" class="mt-6 max-w-2xl">
      <p class="text-ink/80">
        <strong>TODO — placeholder, not real content.</strong> This is scaffolding for one
        anonymized engagement example. Nothing below describes real work. Fill it in or delete the
        section; it should not reach a reader as it stands.
      </p>
    </Callout>

    <Card radius="2xl" padding="lg" surface="cream" class="mt-8 max-w-2xl">
      <dl class="divide-y divide-black/10">
        {engagementExample.map((row) => (
          <div class="py-5 first:pt-0 last:pb-0">
            <dt><Eyebrow>{row.label}</Eyebrow></dt>
            <dd class="mt-2 text-ink/70">{row.todo}</dd>
          </div>
        ))}
      </dl>
    </Card>
  </Section>

  <!-- 8. Newsletter: the closing action. Concise, because the hero above has
       already made the offer in full and repeating it verbatim reads as filler. -->
  <Section background="ink" width="text">
    <NewsletterSignup
      id="newsletter"
      variant="panel"
      onDark
      concise
      buttonLabel="Send me the checklist"
    />
  </Section>

  <script>
    // Fill the "Latest from the newsletter" section from /api/posts. Home stays
    // prerendered; this enhances it. On empty/error, the "Read the blog" link remains.
    (async () => {
      const wrap = document.getElementById('latest-posts');
      if (!wrap) return;
      try {
        const res = await fetch('/api/posts');
        if (!res.ok) return;
        const { posts } = await res.json();
        if (!Array.isArray(posts) || posts.length === 0) {
          // The grid's gap would otherwise indent a single paragraph oddly.
          wrap.className = 'mt-10';
          wrap.innerHTML =
            '<p class="max-w-2xl text-ink/70">Nothing has been published yet. The first piece will appear here as soon as it goes out.</p>';
          return;
        }
        // Three columns is right for three cards and wrong for one: a lone
        // card in a three-track grid sits at a third width with two empty
        // tracks beside it, which reads as a page that failed to load rather
        // than as a blog with one post. Below three, one full-width column.
        // md:grid-cols-3 also appears in the markup above, which is what keeps
        // Tailwind's scanner generating it.
        wrap.className = posts.length >= 3 ? 'mt-10 grid gap-6 md:grid-cols-3' : 'mt-10 grid gap-6';

        const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

        // Built by hand rather than with <Card>, because this section is filled
        // client-side and Astro components no longer exist by then. The classes
        // are the ones <Card> emits, written out in full so Tailwind's scanner
        // still generates them, and the h3 picks up Fraunces from the base layer
        // like any other heading.
        wrap.innerHTML = posts
          .map((p: any) => `
            <a href="/blog/${esc(p.slug)}" class="block rounded-xl border border-black/10 bg-white p-6 no-underline transition hover:border-accent/40">
              <h3 class="text-lg font-semibold text-ink">${esc(p.subject)}</h3>
              ${p.dateLabel ? `<p class="mt-2 text-sm text-ink/60">${esc(p.dateLabel)}</p>` : ''}
              ${p.excerpt ? `<p class="mt-3 text-sm text-ink/70">${esc(p.excerpt)}</p>` : ''}
              <span class="mt-4 inline-block text-sm font-medium text-accent">Read →</span>
            </a>`)
          .join('');
      } catch {
        /* leave the section empty; the Read the blog link still works */
      }
    })();
  </script>
</BaseLayout>
