---
/**
 * The site's icon set, drawn as inline SVG.
 *
 * Replaces the emoji the cards used to carry. Emoji render in the reader's
 * system font, so they arrived in a different style on every platform, ignored
 * the section's colour, and turned full-colour on a page with one accent. These
 * inherit `currentColor` and sit at whatever size the class gives them.
 *
 * Icons are decorative: each one sits beside a heading that already says the
 * same thing, so they carry aria-hidden and every card reads identically to a
 * screen reader without them.
 *
 * Drawn on a 24x24 grid, 1.75 stroke, round caps and joins.
 */
interface Props {
  name: keyof typeof paths;
  class?: string;
}

// One per card in "How I help". An earlier set — key, globe, card, pen, cart,
// mail — was drawn for the v1 sections that have since been removed, and went
// with them rather than sitting here unused under comments about creators and
// revenue platforms. They are in the history if a future section wants them.
const paths = {
  /** A shield with a check: knowing where the business actually stands. */
  shield: ['M12 3l7 3v5.5c0 4.3-2.9 8.2-7 9.5-4.1-1.3-7-5.2-7-9.5V6l7-3z', 'M9 12l2 2 4-4'],
  /** A rising path with plotted points: the prioritized roadmap. */
  route: ['M4 18V7', 'M4 7l6 4 5-4 5 3'],
  /** A clock face: the month-to-month follow-through. */
  clock: ['M12 7.5V12l3 1.75'],
  /** A compass needle: newer risks, taken calmly rather than reactively. */
  compass: ['M15 9l-1.75 4.25L9 15l1.75-4.25L15 9z'],
} as const;

/** Circles that belong to an icon, stroked to match its paths. [cx, cy, r] */
const circles: Partial<Record<keyof typeof paths, [number, number, number][]>> = {
  clock: [[12, 12, 9]],
  compass: [[12, 12, 9]],
};

/** Plotted points on a path, drawn filled rather than stroked. [cx, cy] */
const dots: Partial<Record<keyof typeof paths, [number, number][]>> = {
  route: [
    [10, 11],
    [20, 10],
  ],
};

const { name, class: cls = 'h-6 w-6' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => <path d={d} />)}
  {circles[name]?.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
  {dots[name]?.map(([cx, cy]) => <circle cx={cx} cy={cy} r="1.6" fill="currentColor" stroke="none" />)}
</svg>
