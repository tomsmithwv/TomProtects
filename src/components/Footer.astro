---
import NewsletterSignup from './NewsletterSignup.astro';
import Wordmark from './Wordmark.astro';
import Container from './Container.astro';
import Certifications from './Certifications.astro';
import { SITE } from '../consts';

// Pages whose closing section already contains a signup (e.g. home's final CTA)
// pass showNewsletter={false} to avoid two stacked subscribe forms.
interface Props {
  showNewsletter?: boolean;
}
const { showNewsletter = true } = Astro.props;

const year = new Date().getFullYear();
const links = [
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Work With Me', href: '/workwithme' },
  { label: 'Privacy', href: '/privacy' },
];

// Same rule as the header: the page itself, or a parent of it.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return path === target || (target !== '/' && path.startsWith(`${target}/`));
};
---

<footer class="bg-ink text-cream">
  <Container py="sm">
    {showNewsletter && (
      <div class="mb-10 max-w-md">
        <p class="font-semibold">Get the newsletter</p>
        <p class="mt-1 text-sm text-cream/60">Practical security guidance for small organizations, one email a week.</p>
        <div class="mt-4">
          <NewsletterSignup source="source-newsletter" />
        </div>
      </div>
    )}

    <div class="flex flex-col items-start justify-between gap-6 border-t border-white/10 pt-8 md:flex-row md:items-center">
      <a href="/" aria-label="tomprotects — home"><Wordmark theme="dark" class="h-6 w-auto" /></a>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-cream/70">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class:list={[
              'transition hover:text-cream',
              isCurrent(l.href) &&
                'font-medium text-cream underline decoration-accent-dark decoration-2 underline-offset-8',
            ]}
          >
            {l.label}
          </a>
        ))}
      </nav>
    </div>
    {/*
      The badges close the footer beside the copyright line, small and greyed,
      so they read as a quiet credential rather than a banner. This is the one
      dark band they appear on, so it is the one place the plaque is needed.
    */}
    <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <Certifications size={32} gap="gap-4" onDark label="Professional certifications" />

      <p class="text-xs text-cream/50">
        © {year} {SITE.name}. {SITE.positioning}.
      </p>
    </div>
  </Container>
</footer>
