---
/**
 * The four certification badges, as one quiet row.
 *
 * A credibility marker rather than a feature, so the badges sit desaturated
 * and faded until the reader points at one. Every badge links to its Credly
 * record, which is what makes the claim checkable instead of decorative.
 *
 * Size comes in as a prop rather than a utility class, so the same component
 * can be small in a footer and larger on the About page without a second set
 * of markup. The artwork is pre-sized to 104px (2x the largest use) and lives
 * in public/ rather than going through astro:assets — the Cloudflare adapter
 * turns image optimization off, so an unoptimized import would ship the full
 * originals.
 */
interface Props {
  /** Rendered edge of each badge in px. The artwork is 104px, for 2x screens. */
  size?: number;
  /** Accessible name for the list. */
  label?: string;
  /**
   * On an ink band.
   *
   * The four pieces of artwork have opposite polarity: mean luminance of their
   * opaque pixels runs 215 for CISM and 181 for CDPSE, but 42 for PMP. Against
   * ink at 26 the dark one all but disappears; against a white page the light
   * ones do. So each band gets its own ground — a translucent plaque on ink, a
   * bordered tile on light — and the row reads as a set either way.
   */
  onDark?: boolean;
  /** Space between badges. A Tailwind gap class, since it varies by placement. */
  gap?: string;
  class?: string;
}

const {
  size = 36,
  label = 'Certifications',
  onDark = false,
  gap = 'gap-5',
  class: cls = '',
} = Astro.props;

const badges = [
  {
    src: '/images/certs/cissp.png',
    alt: 'CISSP, Certified Information Systems Security Professional',
    href: 'https://www.credly.com/badges/1c6d302c-adc0-4065-a7cc-7703901fcf0e/public_url',
  },
  {
    src: '/images/certs/cism.png',
    alt: 'CISM, Certified Information Security Manager',
    href: 'https://www.credly.com/badges/6f8fdad1-bacb-43e4-86b1-dd8e10a25296/public_url',
  },
  {
    src: '/images/certs/cdpse.png',
    alt: 'CDPSE, Certified Data Privacy Solutions Engineer',
    href: 'https://www.credly.com/badges/9712e709-5631-418f-ab0d-060f989ed31d/public_url',
  },
  {
    src: '/images/certs/pmp.png',
    alt: 'PMP, Project Management Professional',
    href: 'https://www.credly.com/badges/97edaa44-7f03-4b71-8666-6dff27c6ac62/public_url',
  },
];
---

<ul aria-label={label} class:list={['flex list-none flex-wrap items-center p-0', gap, cls]}>
  {
    badges.map((badge) => (
      <li>
        <a
          href={badge.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            // Quiet comes from the desaturation, not from a fade. An earlier
            // version also dropped these to 60% opacity, which on a light band
            // took the light badges to almost nothing — the same polarity
            // problem the plaque solves on ink, mirrored. Colour returns on
            // hover and on focus.
            'inline-flex rounded p-1 grayscale transition hover:grayscale-0 focus-visible:grayscale-0',
            onDark
              ? // Translucent, so it sits into the band rather than on top of
                // it, and goes solid as the badge lights up.
                'bg-white/80 hover:bg-white focus-visible:bg-white'
              : // On light the plaque cannot add contrast, so the tile is given
                // an edge instead — which is what a pale badge needs there.
                'bg-white ring-1 ring-black/10 hover:ring-black/20',
          ]}
        >
          <img
            src={badge.src}
            alt={badge.alt}
            width={size}
            height={size}
            style={`width:${size}px;height:${size}px`}
            loading="lazy"
            decoding="async"
            class="object-contain"
          />
        </a>
      </li>
    ))
  }
</ul>
