---
import Wordmark from './Wordmark.astro';
import Container from './Container.astro';
import Button from './Button.astro';
// Primary navigation. The primary CTA → /workwithme. Its label is the page's
// own name, "Work with me", and it is the same string in the desktop pill, the
// mobile menu and the footer link. Three spellings of one destination read as
// three destinations, which is what "Get Started" and "Work With Me" were
// doing here.
const links = [
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
];

// A link is current if it is the page, or the parent of it (/blog/a-post).
// Trailing slashes are stripped from both sides first, because Astro will
// serve /about and /about/ alike and the two must not disagree here.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return path === target || (target !== '/' && path.startsWith(`${target}/`));
};
---

<header class="sticky top-0 z-40 border-b border-black/10 bg-cream/90 backdrop-blur">
  <Container py="none" class="flex items-center justify-between py-4">
    <a href="/" aria-label="tomprotects — home"><Wordmark theme="light" class="h-5 w-auto" /></a>

    <nav class="hidden items-center gap-6 text-sm md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
          class:list={[
            'transition',
            isCurrent(l.href)
              ? 'font-medium text-ink underline decoration-accent decoration-2 underline-offset-8'
              : 'text-ink/70 hover:text-ink',
          ]}
        >
          {l.label}
        </a>
      ))}
      <Button href="/workwithme" size="sm">Work with me</Button>
    </nav>

    <button
      id="nav-toggle"
      class="md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="text-2xl leading-none">☰</span>
    </button>
  </Container>

  <div id="mobile-menu" class="hidden border-t border-black/10 md:hidden">
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={isCurrent(l.href) ? 'page' : undefined}
        class:list={[
          'block px-6 py-3',
          isCurrent(l.href) ? 'font-medium text-ink' : 'text-ink/70',
        ]}
      >
        {l.label}
      </a>
    ))}
    <a href="/workwithme" class="block px-6 py-3 font-semibold text-accent">Work with me</a>
  </div>

  <script>
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      menu.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          menu.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
        }),
      );
    }
  </script>
</header>
